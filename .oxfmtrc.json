{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/build", "**/node_modules", "**/*.md"],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.yml"],
      "options": {
        "tabWidth": 2
      }
    }
  ],

  // Rules
  "arrowParens": "avoid",
  "htmlWhitespaceSensitivity": "ignore",
  "printWidth": 120,
  "sortImports": {
    "groups": [
      "external",
      "builtin",
      "subpath",
      "index",
      "sibling",
      "parent",
      "side_effect",
      "style",
      "side_effect_style",
      "type"
    ],
    "newlinesBetween": true
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./client/src/lib/css/index.css"
  },
  "tabWidth": 4,
  "trailingComma": "none"
}
